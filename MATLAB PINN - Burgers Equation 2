PINN Loss Function
function [loss, gradients] = modelLoss(net, nu, X, T, X0, T0, U0, boundaryloss, physicsloss)
XTK = cat(1, X, T);
U = forward(net, XTK);

X = stripdims(X);
T = stripdims(T);
U = stripdims(U);
Ux = dljacobian(U, X, 1);
Ut = dljacobian(U, T, 1);
Uxx = dldivergence(Ux, X, 1);

% Burgers' equation residual
f = Ut + U .* Ux - (nu) * Uxx;
mseF = physicsloss * mean(f.^2);

% Boundary Condition Loss
XTK0 = cat(1, X0, T0);
U0Pred = forward(net, XTK0);
mseU = boundaryloss * l2loss(U0Pred, U0);

% Total Loss
loss = mseF + mseU;
gradients = dlgradient(loss, net.Learnables);
end

Integration Solver
function U = solveBurgers(X, t, nu)
% Define functions.
f = @(y) exp(-cos(pi*y)/(2*pi*nu));
g = @(y) exp(-(y.^2)/(4*nu*t));

% Initialize solutions. Size should be ng + 1 to ensure proper dimensions
U = zeros(numel(X), 1);

% Loop over x values (starting from the second element to ignore the first row)
for i = 1:numel(X)
x = X(i); % Adjust index to match the X values properly

% Calculate the solutions using the integral function. The boundary
% conditions in x = -1 and x = 1 are known, so leave 0 as they are
% given by initialization of U.
if abs(x) ~= 1
fun = @(eta) sin(pi*(x-eta)) .* f(x-eta) .* g(eta);
uxt = -integral(fun, -inf, inf);
fun = @(eta) f(x-eta) .* g(eta);
U(i) = uxt / integral(fun, -inf, inf);
end
end
end
