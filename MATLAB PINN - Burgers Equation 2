clc; clear; close all;

Problem Parameters - General
L = 2; % Length of domain
nu = 0.01 / pi; % Viscosity term (constant)
ng = 100; % Number of grid points

dt = 0.001; % Time step
nt = round(1 ./ dt); % Compute nt for each dt

numObservationsTrain = 10; % Number of observations

Problem Parameters - Initial Condition
xVals = linspace(-1, 1, ng);
u0IC = -sin(pi * xVals);

Problem Parameters - PINN
nc = 20; % percentage of timesteps to have boundary conditions
numBoundaryConditionPoints = [nc, nc];
numInternalCollocationPoints = 10000;
numBlocks = 8;
fcOutputSize = 20;

maxIterations = 100000;
gradientTolerance = 1e-4;
stepTolerance = 1e-6;

physicsloss = 1;
boundaryloss = 5;

Problem Parameters - Calculations
dx = L / (ng - 1);
CFL = max(abs(u0IC)) * dt / dx;

if CFL > 1
error('Time step is too large for stability. Decrease dt or increase dx.');
end

FDM - Calculation
U0 = u0IC;
U1 = U0;
U_FDM = ones(nt, ng-2);

for j = 1:nt
for i = 2:ng-1
U1(i) = U0(i) - dt * U0(i) * (U0(i) - U0(i-1)) / dx + nu * dt * (U0(i+1) - 2*U0(i) + U0(i-1)) / dx^2;
end
U_FDM(j, :) = U1(2:end-1);
U0 = U1;
end

PINN - Boundary Conditions and data formatting
xMin = -1; xMax = 1;

x0BC1 = xMin * ones(1, numBoundaryConditionPoints(1));
x0BC2 = xMax * ones(1, numBoundaryConditionPoints(2));
t0BC1 = linspace(0, dt * nt, numBoundaryConditionPoints(1));
t0BC2 = linspace(0, dt * nt, numBoundaryConditionPoints(2));
u0BC1 = zeros(1, numBoundaryConditionPoints(1));
u0BC2 = zeros(1, numBoundaryConditionPoints(2));

% Combine Initial and Boundary Condition Points
X0 = [xVals, x0BC1, x0BC2];
T0 = [zeros(1, ng), t0BC1, t0BC2];
U0 = [u0IC, u0BC1, u0BC2];

% Collocation Points
points = rand(numInternalCollocationPoints, 2);
dataX = (xMax - xMin) * points(:,1) + xMin;
dataT = dt * nt * points(:,2);

% Convert to deep learning array
X = dlarray(dataX, "BC");
T = dlarray(dataT, "BC");

X0 = dlarray(X0, "CB");
T0 = dlarray(T0, "CB");
U0 = dlarray(U0, "CB");

PINN - Neural Network Structure
fcBlock = [
fullyConnectedLayer(fcOutputSize)
tanhLayer
];
layers = [
featureInputLayer(2) % 2 inputs: x, t
repmat(fcBlock, [numBlocks, 1])
fullyConnectedLayer(1)
];
net = dlnetwork(layers);
net = dlupdate(@double, net);

PINN - Learning Conditions
solverState = lbfgsState;
accfun = dlaccelerate(@modelLoss);
lossFcn = @(net) dlfeval(accfun, net, nu, X, T, X0, T0, U0, boundaryloss, physicsloss);
monitor = trainingProgressMonitor( Metrics="TrainingLoss", Info=["Iteration" "GradientsNorm" "StepNorm"], XLabel="Iteration");

PINN - Iteration Loop
monitor.Metrics = ["TrainingLoss", "GradientsNorm", "StepNorm"];
iteration = 0;
while iteration < maxIterations && ~monitor.Stop
    iteration = iteration + 1;
    [net, solverState] = lbfgsupdate(net, lossFcn, solverState);
    
    updateInfo(monitor, Iteration=iteration, GradientsNorm=solverState.GradientsNorm, StepNorm=solverState.StepNorm);
    recordMetrics(monitor, iteration, TrainingLoss=solverState.Loss, GradientsNorm=solverState.GradientsNorm, StepNorm=solverState.StepNorm);
    
    monitor.Progress = 100 * iteration / maxIterations;
    
    if solverState.GradientsNorm < gradientTolerance || solverState.StepNorm < stepTolerance
        break;
    end
end

Extract Predictions for Full Domain
TTrain = linspace(0, dt * nt, nt);
XTrain = dlarray(xVals, "CB");
UPredTrain = zeros(nt, ng);

for i = 1:nt
TTrain_i = repmat(TTrain(i), [1, ng]);
TTrain_i = dlarray(TTrain_i, "CB");
XTTTrain = cat(1, XTrain, TTrain_i);
UPredTrain(i, :) = extractdata(forward(net, XTTTrain));
end

