Function - PINN Loss
function [loss, gradients] = modelLoss(net, k, X, T, X0, T0, U0, boundaryloss, physicsloss)

XT = cat(1, X, T);
U = forward(net, XT);

X = stripdims(X);
T = stripdims(T);
U = stripdims(U);
Ux = dljacobian(U, X, 1);
Ut = dljacobian(U, T, 1);
Uxx = dldivergence(Ux, X, 1);

% Heat equation loss using fixed k
f = Ut - k * Uxx;
mseF = physicsloss * mean(f.^2);

% Boundary Condition Loss
XT0 = cat(1, X0, T0);
U0Pred = forward(net, XT0);
mseU = boundaryloss * l2loss(U0Pred, U0);

% Total Loss
loss = mseF + mseU;
gradients = dlgradient(loss, net.Learnables);
end

Function - Analytical
% Function to solve the heat equation analytically
function U = solveHeatEquation(X, t, k)
    heatKernel = @(x, x0, t, k) (1 / sqrt(4 * pi * k * t)) * exp(-(x - x0).^2 / (4 * k * t));
    U = zeros(numel(X), 1);
    for i = 1:numel(X)
        x = X(i);
        if t > 0
            integrand = @(x0) initialCondition(x0) .* heatKernel(x, x0, t, k);
            U(i) = integral(integrand, -inf, inf);
        else
            U(i) = initialCondition(x);
        end
    end
end

% Define initial condition function
function u0 = initialCondition(x)
    u0 = sin(pi * x);
end
